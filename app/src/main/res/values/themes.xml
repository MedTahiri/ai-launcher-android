<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shows the system wallpaper behind the window; the home screen paints over it unless the background is "wallpaper". -->
    <style name="Launcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
