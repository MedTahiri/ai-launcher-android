<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the drawer's Uninstall open Android's own uninstall screen, which always asks first. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Lets private apps ask for the fingerprint, face or screen lock. It gives no access to anything by itself. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Lets the launcher see the apps it lists. No QUERY_ALL_PACKAGES: it only needs apps with an icon. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets spoken app names find a voice that will speak, when the default one won't. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Lets search offer "Search the web" only when an app can do it. -->
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <!-- Lets it see icon packs, which announce themselves with these, and read their icons. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <!-- Lets it see the apps that offer home screen widgets, to show and add them. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Launcher">

        <activity
            android:name=".core.HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification dots. Off until launcher.json asks for them (core/NotificationDots.kt), and even then Android only
             connects it once the person allows notification access in Settings. -->
        <service
            android:name=".core.NotificationDotsService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Gestures that pull down notifications or lock the screen. Off until launcher.json uses one
             (core/Gestures.kt), and even then it only works once the person turns it on in Accessibility. -->
        <service
            android:name=".core.GestureService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gesture_service" />
        </service>

        <!-- Its own process, so nothing that crashed the home screen can take it down too. -->
        <activity
            android:name=".core.SafeModeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":safe"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>
</manifest>
